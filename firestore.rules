rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.uid == uid
        && request.resource.data.id == uid && request.resource.data.role == 'user';
      allow update: if owner(uid) && request.resource.data.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'email', 'phone', 'bio', 'photoPath', 'updatedAt']);
      // Account deletion is outside Part 7.
      allow delete: if false;
      match /{collection}/{document} {
        allow read, delete: if owner(uid) && collection in
          ['favorites', 'itineraries', 'guideNotes', 'supportRequests', 'preferences'];
        allow create, update: if owner(uid) && collection in
          ['favorites', 'itineraries', 'guideNotes', 'supportRequests', 'preferences']
          && (collection != 'preferences' || (document == 'settings'
            && request.resource.data.selectedLanguageCode in ['en', 'si', 'ta']));
      }
    }

    function validPlace(data, id) {
      return data.id == id && data.name is string && data.name.size() > 0
        && data.name.size() <= 10000
        && data.description is string && data.description.size() > 0
        && data.description.size() <= 10000
        && data.city is string && data.city.size() > 0
        && data.district is string && data.district.size() > 0
        && data.category in ['Ancient Cities', 'Temples', 'Forts', 'Nature', 'Architecture']
        && data.isActive is bool
        && (data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180));
    }
    function validContact(data, id) {
      return data.id == id && data.name is string && data.name.size() > 0 && data.name.size() <= 10000
        && data.description is string && data.description.size() > 0 && data.description.size() <= 10000
        && data.category in ['police', 'ambulance', 'medical', 'fire', 'touristPolice', 'disaster', 'other']
        && data.phoneNumber is string && data.phoneNumber.matches('^\\+?[0-9]{2,15}$')
        && data.isActive is bool && data.isVerified is bool
        && data.priority is int && data.priority >= 0 && data.priority <= 999;
    }
    match /emergencyContacts/{id} {
      allow read: if admin() || (signedIn() && resource.data.isActive == true && resource.data.isVerified == true);
      allow create: if admin() && validContact(request.resource.data, id)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if admin() && validContact(request.resource.data, id)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /places/{id} {
      allow read: if admin() || (signedIn() && resource.data.isActive == true);
      allow create: if admin() && validPlace(request.resource.data, id)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if admin() && validPlace(request.resource.data, id)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }

    function validReview(data, placeId, reviewId) {
      return data.keys().hasOnly(['id', 'placeId', 'userId', 'userDisplayName', 'rating', 'comment', 'createdAt', 'updatedAt'])
        && data.id == reviewId && data.userId == reviewId && data.placeId == placeId
        && data.userDisplayName is string && data.userDisplayName.size() > 0 && data.userDisplayName.size() <= 80
        && !data.userDisplayName.matches('.*@.*')
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1000
        && data.comment.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }
    function reviewable(placeId) {
      return exists(/databases/$(database)/documents/places/$(placeId))
        && get(/databases/$(database)/documents/places/$(placeId)).data.isActive == true;
    }
    match /places/{placeId}/reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if owner(reviewId) && reviewable(placeId) && validReview(request.resource.data, placeId, reviewId)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owner(reviewId) && resource.data.userId == request.auth.uid
        && reviewable(placeId) && validReview(request.resource.data, placeId, reviewId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'userDisplayName', 'updatedAt']);
      allow delete: if owner(reviewId) || admin();
    }
    // Admin collection-group moderation includes reviews of deleted places.
    // This grants reads only; all writes still require the exact places path.
    match /{parent=**}/reviews/{reviewId} {
      allow read: if admin();
    }

    function validMember(member, uid, leader) {
      return member is map && member.id == uid && member.name is string
        && member.name.size() > 0 && member.name.size() <= 60
        && member.isLeader == leader && member.isSharingLocation is bool
        && member.keys().hasOnly(['id', 'name', 'avatarPath', 'isLeader', 'isSharingLocation', 'lastUpdated']);
    }
    function validGroup(data, id) {
      return data.id == id && data.name is string
        && data.name.size() > 0 && data.name.size() <= 60
        && data.members is map && data.memberIds is list
        && data.memberIds.size() > 0 && data.memberIds.size() <= 50
        && data.members.keys().toSet() == data.memberIds.toSet()
        && data.leaderId in data.memberIds
        && validMember(data.members[data.leaderId], data.leaderId, true)
        && data.inviteCode.matches('^HW-[A-Z0-9]{16}$');
    }
    match /groups/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && validGroup(request.resource.data, id)
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && getAfter(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)).data.groupId == id;
      allow delete: if signedIn() && resource.data.leaderId == request.auth.uid;
      allow update: if signedIn() && validGroup(request.resource.data, id)
        && request.resource.data.leaderId == resource.data.leaderId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.createdAt == resource.data.createdAt
        && (leaderUpdate() || ownMemberUpdate() || joinWithCode());
      function leaderUpdate() {
        return resource.data.leaderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'destinationPlaceId', 'destinationName', 'leaderName', 'members', 'memberIds', 'memberOperationId', 'updatedAt'])
          && (request.resource.data.members == resource.data.members
            || (request.resource.data.memberIds == resource.data.memberIds
              && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.members[request.auth.uid].diff(resource.data.members[request.auth.uid])
                .affectedKeys().hasOnly(['name', 'avatarPath', 'isSharingLocation', 'lastUpdated']))
            || leaderMemberOperation());
      }
      function leaderMemberOperation() {
        let target = request.resource.data.memberOperationId;
        return target != resource.data.leaderId
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([target])
          && ((target in resource.data.memberIds && !(target in request.resource.data.memberIds))
            || (!(target in resource.data.memberIds) && target.matches('^demo-member-[A-Za-z0-9-]+$')
              && validMember(request.resource.data.members[target], target, false)));
      }
      function ownMemberUpdate() {
        return request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt', 'joinCode'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && validMember(request.resource.data.members[request.auth.uid], request.auth.uid,
            resource.data.leaderId == request.auth.uid)
          && request.resource.data.members[request.auth.uid].diff(resource.data.members[request.auth.uid])
            .affectedKeys().hasOnly(['name', 'avatarPath', 'isSharingLocation', 'lastUpdated'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['joinCode'])
            || request.resource.data.joinCode == resource.data.inviteCode);
      }
      function joinWithCode() {
        return !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'joinCode', 'updatedAt'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && validMember(request.resource.data.members[request.auth.uid], request.auth.uid, false);
      }
    }
    function groupLocationMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    match /groups/{groupId}/locations/{uid} {
      allow read: if groupLocationMember(groupId);
      allow create, update: if owner(uid) && groupLocationMember(groupId)
        && request.resource.data.keys().hasOnly(['userId', 'displayName', 'latitude', 'longitude', 'updatedAt'])
        && request.resource.data.keys().hasAll(['userId', 'displayName', 'latitude', 'longitude', 'updatedAt'])
        && request.resource.data.userId == uid
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80 && !request.resource.data.displayName.matches('.*@.*')
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt == request.time;
      // Former members can erase only their own snapshot after leaving.
      allow delete: if owner(uid);
    }
    match /groupInvites/{code} {
      // Code holders may resolve an invite; enumeration is forbidden.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.keys().hasOnly(['groupId', 'leaderId'])
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.leaderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;
      allow delete: if signedIn() && resource.data.leaderId == request.auth.uid;
      allow update: if false;
    }
  }
}
